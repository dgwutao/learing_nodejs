page{
  background-color: #f5f5f5;
}

.round{
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
}

.line {
  width: 100%;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 28rpx;
  color: #1d1e1f;
  margin-top: 40rpx;
}

.popup {
  position: absolute;
  font-size: 28rpx;
  background-color: #4c4c4c;
  padding: 20rpx 10rpx;
  color: white;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-radius: 10rpx;
  z-index: 10;
  
  left: 33vw;
}

.popup .corner {
  position: absolute;
  top: 105rpx;
  width: 24rpx;
  border: 14rpx solid #4c4c4c;
  border-bottom-color: transparent;
  border-left-color: transparent;
  border-right-color: transparent
}

.popup .item {
  padding: 0 15rpx;
}