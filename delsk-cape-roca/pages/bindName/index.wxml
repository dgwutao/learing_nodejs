<view style="display: flex;flex-direction: column;align-items: center;justify-content: center;">
<image src="/image/roca_bind_icon.png" mode="widthFix" style="width: 100%;margin-top: 150rpx;"/>
<view style="font-size: 36rpx;color: #41ab87;margin-top: 20rpx;">欢迎来到ROCA葡语小程序</view>
<view style="padding: 130rpx;width: 100%;">
<input type="nickname" bindinput="handleChange" style="font-size: 30rpx;width: 100%;" placeholder-style="font-size:28rpx;color:#999999"  value="{{value}}" placeholder="请输入您的昵称…"></input>
<view style="height: 2rpx;width: 100%;background-color: #e5e5e5;margin-top: 20rpx;margin-bottom: 20rpx;"></view>
<view style="font-size: 20rpx;color: #bbbbbb;">昵称由中文、英文、数字组成</view>
<view bindtap="OK" class="{{value.length>0?'button_green':'button_normal'}}">确定</view>
</view>
</view>