<view style="position: relative;">
<image src="https://staticpms.delsk.com/images/edu/word_bg.png" mode="widthFix" style="width: 100%;position: absolute;top: 0;z-index: -99;"/>
<view style="height: 260rpx;"></view>
<view style="padding:20rpx;">
<view wx:for="{{tree}}" wx:for-index="idx" style="border-radius: 24rpx;background-color: {{idx==0?'transparent':'white'}};padding: 30rpx 0 30rpx 20rpx;margin-bottom: 20rpx;position: relative;">
<image wx:if="{{idx==0}}" src="/image/0_square.png" mode="aspectFill" style="width: 100%;position: absolute;top: 0;left: 0;z-index: -9;height: 100%;border-radius: 24rpx;"/>
<view style="display: flex;align-items: center;z-index: 999;">
<image src="/image/0_{{idx+1}}.png" style="width: 56rpx;height: 56rpx;"/>
<view style="font-size: 32rpx;font-weight: bold;color: #333333;">{{item.name}}</view>
</view>
<view style="display: flex;align-items: center;flex-wrap: wrap;z-index: 999;">
<view bindtap="toDetail" data-id="{{subitem.id}}" wx:for="{{item.list}}" wx:for-item="subitem" style="width: 20vw;height: 20vw;border-radius: 18rpx;background-color: #F3FBFA;margin-top: 24rpx;margin-right: 20rpx;display: flex;align-items: center;justify-content: flex-start;flex-direction: column;">
<view style="font-size: 44rpx;color: #4D514F;font-weight: bold;text-align: center;margin-top: 20rpx;">{{subitem.zm_daxie}}{{subitem.zm_xiaoxie}}</view>
<image src="/image/0_c.png" style="width: 32rpx;height: 14rpx;margin-top: 30rpx;"/>
</view>
</view>
</view>
</view>


</view>

<view style="height: 100rpx;"></view>

