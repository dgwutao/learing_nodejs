</view>


</view>
<view style="width: 100%;height: 24rpx;background-color: #efefef;"></view>
<view style="padding: 40rpx;">
<view style="display: flex;align-items: center;margin-top: 50rpx;width: 100%;">
<view bindtap="changeTab" data-tab="0" style="position: relative;">
<view style="width:128rpx;height:28rpx;background:linear-gradient(90deg, #56CDAF 0%, rgba(137,230,212,0) 100%);border-radius: 20rpx;visibility: {{tab==0?'visibility':'hidden'}};"></view>
<view style="font-size: {{tab==0?'32':'28'}}rpx;font-weight: {{tab==0?'bold':'normal'}};position: absolute;top: -20rpx;left: 0;color: {{tab==0?'#333333':'#666666'}};">已提交</view>
</view>

<view bindtap="changeTab" data-tab="1" style="position: relative;margin-left: 60rpx;">
<view style="width:128rpx;height:28rpx;background:linear-gradient(90deg, #56CDAF 0%, rgba(137,230,212,0) 100%);border-radius: 20rpx;visibility: {{tab==1?'visibility':'hidden'}};"></view>
<view style="font-size: {{tab==1?'32':'28'}}rpx;font-weight: {{tab==1?'bold':'normal'}};position: absolute;top: -20rpx;left: 0;color: {{tab==1?'#333333':'#666666'}};">未提交</view>
</view>
</view>

<view wx:if="{{tab==0}}">
<view wx:for="{{list}}">
<view wx:if="{{item.is_post==1}}" bindtap="goDetail" data-item="{{item}}" style="display: flex;align-items: center;justify-content: space-between;height: auto;">
<image src="{{item.head.length>0?item.head:'/image/avatar.png'}}" style="width: 80rpx;height: 80rpx;border-radius: 18rpx;margin-top: 20rpx;margin-bottom: 20rpx;"/>
<view style="margin-left: 20rpx;flex: 1;">
<view style="display: flex;align-items: flex-start;justify-content: space-between;margin-top: 30rpx;">
<view style="font-size: 28rpx;color: #1d1e1f;">{{item.name}}</view>
<view style="font-size: 20rpx;color: white;font-weight: bold;padding: 6rpx 16rpx;background: linear-gradient(90deg, #05A09D 0%, rgba(4,160,157,0.53) 100%);border-radius: 24rpx;">查看作业</view>
</view>
<view style="width: 100%;height: 2rpx;background-color: #d0d0d0;margin-top: 30rpx;"></view>
</view>
</view>
</view>
</view>

<view wx:if="{{tab==1}}">
<view wx:for="{{list}}">
<view wx:if="{{item.is_post==0}}" bindtap="goDetail" data-item="{{item}}" style="display: flex;align-items: center;justify-content: space-between;height: auto;">
<image src="{{item.head.length>0?item.head:'/image/avatar.png'}}" style="width: 80rpx;height: 80rpx;border-radius: 18rpx;margin-top: 20rpx;margin-bottom: 20rpx;"/>
<view style="margin-left: 20rpx;flex: 1;">
<view style="display: flex;align-items: flex-start;justify-content: space-between;margin-top: 30rpx;">
<view style="font-size: 28rpx;color: #1d1e1f;">{{item.name}}</view>
</view>
<view style="width: 100%;height: 2rpx;background-color: #d0d0d0;margin-top: 30rpx;"></view>
</view>
</view>
</view>
</view>
</view>

<view style="height: 200rpx;"></view>

<van-popup z-index="999999" show="{{showAudioRates}}" position="bottom" custom-class="round" custom-style="height:800rpx;width:100%;z-index:99999999;position:fixed;" bind:close="sizerClose">
<view wx:for="{{audioRates}}" bindtap="rate_c" data-item="{{item}}" style="padding: 34rpx 0;display: flex;align-items: center;justify-content: center;">
  <view style="font-size:30rpx;color: {{item==currentAudioRate?'#479693':'black'}};">{{item}}</view>
</view>
<view style="height: 14rpx;background-color: #f7f7f7;"></view>
<view bindtap="sizerClose" style="padding: 34rpx 0;display: flex;align-items: center;justify-content: center;">
  <view style="font-size:32rpx;">取消</view>
</view>
</van-popup>