<view style="padding: 40rpx;">
<view style="display: flex;align-items: center;">
<image src="/image/roca_homework_course_icon.png" style="width: 76rpx;height: 76rpx;border-radius: 18rpx;"/>
<view style="margin-left: 16rpx;">
<view style="font-size: 28rpx;font-weight: bold;color: #1d1e1f;">{{course.title}}</view>
<view style="font-size: 24rpx;color: #666666;margin-top: 4rpx;">发布时间：{{info.create_time}}</view>
</view>
</view> 
<view style="padding: 40rpx 0;">
<text style="font-size: 28rpx;color: #1d1e1f;">{{info.content}}</text>

<view wx:for="{{info.pics}}">
  <image bindtap="preview" data-urls="{{info.pics}}" data-url="{{item}}" src="{{item}}" mode="widthFix" style="width: 100%;margin-top: 22rpx;border-radius: 20rpx;"/>
</view>
<view wx:if="{{info.audios.length>0&&!fold}}" style="margin-top: 20rpx;background-color:#F1F5F5;border-radius: 12rpx;padding: 0 20rpx;">
<view wx:for="{{info.audios}}" wx:for-index="idx">
<view style="padding: 30rpx 0;border-bottom: {{idx==info.audios.length-1?'0':'2'}}rpx #E5E5E5 solid;">
  <view bind:tap="foldAudio" data-audio="{{item.name}}" style="display: flex;align-items: center;justify-content: space-between;">
    <view style="font-size: 28rpx;color: #1D1E1F;">{{item.name}}</view>
    <view wx:if="{{fold_audio_name!=item.name}}" style="font-size: 22rpx;color: #333333;">{{item.end}}</view>
  </view>
  
  <view wx:if="{{fold_audio_name==item.name}}" style="margin-top: 20rpx;">
    <slider data-index="{{idx}}" data-playing="{{item.name}}" data-url="{{item.url}}"  bindchanging="sliderChanging" bindchange='sliderChanged' min="0" max="100" value="{{item.value}}" color="#DDDEDD" activeColor="#8F8F94" block-size="10rpx" block-color="#8F8F94" style="margin-left: 10rpx;margin-right: 0;margin-bottom: 0;"></slider>
    <view style="display: flex;align-items: center;justify-content: space-between;margin-top: 8rpx;">
    <view style="font-size: 20rpx;color: #999999;">{{item.start}}</view>
    <view style="font-size: 20rpx;color: #999999;">{{item.end}}</view>
    </view>
    <view style="display: flex;align-items: center;justify-content: center;position: relative;padding: 10rpx 0;">
    <image catch:tap="f_5s" data-type="rewind" data-index="{{idx}}" data-playing="{{item.name}}" data-url="{{item.url}}" src="/image/fff_5s_rewind.png" style="width: 40rpx;height: 44rpx;"/>
    <image catchtap="playVoice" data-index="{{idx}}" data-playing="{{item.name}}" data-url="{{item.url}}" src="/image/fff_{{playing_audio_state==item.name?'pause':'play'}}.png" style="width: 54rpx;height: 54rpx;margin-left: 64rpx;margin-right: 64rpx;"/>
    <image catch:tap="f_5s" data-type="forward" data-index="{{idx}}" data-playing="{{item.name}}" data-url="{{item.url}}" src="/image/fff_5s_forward.png" style="width: 40rpx;height: 44rpx;"/>

    <view catch:tap="showRates" style="font-size: 22rpx;color: #333333;position: absolute;right: 0;bottom: 0;">{{currentAudioRate}}X倍速</view>
    </view>


  </view>
</view>

<!-- <image src="/image/trangle_left.png" mode="widthFix" style="width: 12rpx;margin-right:-2rpx;"/> -->
