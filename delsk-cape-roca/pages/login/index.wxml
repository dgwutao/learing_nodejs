<view style="display: flex;flex-direction: column;align-items: center;justify-content: center;">
<image src="/image/roca_login_icon.png" mode="widthFix" style="margin-top: 380rpx;"/>
<view style="padding: 0 100rpx;width: 100%;">
<button class="button" style="padding: 0;background-color: transparent;line-height: unset;margin-top: 160rpx;box-shadow: 0 10rpx 34rpx 0 rgba(68,171,135,0.61);border-radius: 32rpx;" open-type="getPhoneNumber" bindgetphonenumber="WeixinLogin">
<view style="font-size: 32rpx;color: white;font-weight: bold;text-align: center;padding: 24rpx 0;background: #50D0A5;border-radius: 32rpx;width: 100%;">手机号快速登录</view>
</button>
</view>
<view style="font-size: 22rpx;color: #999999;margin-top: 20rpx;">未注册用户将自动注册</view>
</view>



