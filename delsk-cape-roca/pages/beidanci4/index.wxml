<view style="padding: 0 30rpx;">
<view style="display: flex;align-items: center;justify-content: space-between;margin-top: 40rpx;">
<view style="font-size: 56rpx;color: #1d1e1f;font-weight: bold;">{{info.danci}}</view>
<image bindtap="collect" src="/image/ff_0{{info.is_shoucang==1?'8':'7'}}.png" mode="widthFix" style="width: 40rpx;height: 40rpx;"/>
</view>
<image bindtap="playVoice" data-item="{{info}}" src="/image/{{playing_audio_state==info.yinpin?'ff_15.gif':'ff_06.png'}}" mode="widthFix" style="width: 44rpx;height: 44rpx;margin-top: 10rpx;"/>

<view style="background-color: white;border-radius: 12rpx;margin-top: 50rpx;padding: 20rpx;">
<view style="font-size: 28rpx;">释义：</view>
<view style="margin-top: 10rpx;font-size: 36rpx;font-weight: bold;">{{info.shiyi_cn}}</view>
<image wx:if="{{info.peitu.length>0}}" bindtap="preview" data-url="{{info.peitu}}" src="{{info.peitu}}" mode="aspectFill" style="width: 290rpx;height: 216rpx;margin-top: 40rpx;border-radius: 12rpx;"/>
</view>

<view style="background-color: white;border-radius: 12rpx;margin-top: 50rpx;padding: 20rpx;">
<view style="font-size: 28rpx;">英文释义：</view>
<view style="margin-top: 10rpx;font-size: 36rpx;font-weight: bold;">{{info.shiyi_en}}</view>
</view>
</view>