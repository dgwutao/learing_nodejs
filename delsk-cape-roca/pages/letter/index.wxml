<view>

<view wx:if="{{data.fayin.length>1}}" style="font-size: 160rpx;color: #2B8F8C;font-weight: bold;text-align: center;background-color: #F3FBFA;padding: 100rpx 0;">{{data.zm_daxie}}  {{data.zm_xiaoxie}}</view>

<view wx:else style="font-size: 160rpx;color: #2B8F8C;font-weight: bold;text-align: center;padding: 100rpx 0;background-color: #F3FBFA;">{{data.zm_daxie}}  {{data.zm_xiaoxie}}</view>

<scroll-view wx:if="{{data.fayin.length>1}}" scroll-into-view="{{toView}}" scroll-x="true" style="white-space: nowrap;background-color: white;box-shadow: 0 -6rpx 11rpx 0 rgba(79,132,108,0.11);border-top-left-radius: 46rpx;border-top-right-radius: 46rpx;width: calc(100vw - 40rpx);padding: 0 20rpx;">
<view style="padding: 50rpx 0 30rpx 0;display: flex;align-items: center;width:max-content;">
<view bindtap="switch" data-id="{{idx}}" wx:for="{{data.fayin}}" wx:for-index="idx" style="position: relative;display: flex;flex-direction: column;align-items: center;justify-content: center;margin-right: 70rpx;margin-left: 0;">
<view id="{{'id_'+item.id}}" style="font-size: {{idx==tab?'40':'36'}}rpx;color: {{idx==tab?'#1D1E1F':'#999999'}};font-weight: {{idx==tab?'bold':'normal'}};flex-shrink: 0;">{{item.fy_name}}</view>
<view style="width: 30rpx;height: 16rpx;background: #66C5C3;border-radius: 12rpx;margin-top: 14rpx;visibility:{{idx==tab?'visible':'hidden'}};"/>
</view>
</view>
</scroll-view>

<view wx:if="{{data.fayin.length>1}}" style="padding: 0 20rpx;"><view style="border-bottom: 2rpx #EAEAEA solid;"></view></view>


<swiper wx:if="{{data.fayin.length>1}}" style="height:{{swiperHeight}}rpx;" current="{{tab}}" bindchange="swiperChange">
      <view wx:for="{{data.fayin}}" wx:for-index="index">
        <swiper-item>
        <view class="a-class-{{tab}}" >
          <view style="width: 100%;display: flex;align-items: center;justify-content: center;margin-top: 70rpx;">
            <image bindtap="playVoice" data-playing="{{current.map.url}}" src="/image/{{playing_audio_state==current.map.url?'0_playing.gif':'0_play2.png'}}" style="width: 100rpx;height: 100rpx;"/>
          </view>

          <view wx:if="{{current.fy_jiqiao.length>0}}" style="display: flex;align-items: center;margin-top: 20rpx;padding: 0 20rpx;">
          <image src="/image/0_b.png" style="width: 44rpx;height: 44rpx;"/>
          <view style="font-size: 32rpx;color: #1D1E1F;font-weight: bold;margin-left: 14rpx;">发音技巧：</view>
          </view>

          <view wx:if="{{current.fy_jiqiao.length>0}}" style="padding: 20rpx 30rpx;background: rgba(228,238,237,0.42);border-radius: 20rpx;margin-top: 40rpx;word-wrap: break-word;margin-left: 20rpx;margin-right: 20rpx;font-size: 28rpx;color: #7B7B7B;">{{current.fy_jiqiao}}</view>

          <view wx:if="{{data.xiangugan.length>0}}" style="display: flex;align-items: center;margin-top: 50rpx;margin-bottom: 50rpx;padding: 0 20rpx;">
          <image src="/image/0_a.png" style="width: 44rpx;height: 44rpx;"/>
          <view style="font-size: 32rpx;color: #1D1E1F;font-weight: bold;margin-left: 14rpx;">相关发音：</view>
          </view>

          <view>
            <view wx:for="{{data.xiangugan}}" wx:for-index="idx">
            <view wx:if="{{idx==tab2}}" style="background-color: white;padding: 50rpx 0;display: flex;align-items: center;justify-content: center;flex-direction: column;">
            <image wx:if="{{item.img.length>0}}" src="{{item.img}}" mode="aspectFill" style="width: 60vw;height: 30vw;border-radius: 20rpx;border: 2rpx #E7F6F6 solid;"/>
            <image bindtap="playVoice" data-playing="{{item.yinpin}}" mode="aspectFill" src="/image/{{playing_audio_state==item.yinpin?'0_playing.gif':'0_play2.png'}}" style="width: 80rpx;height: 80rpx;margin-top: 30rpx;"/>
            <view style="font-size: 52rpx;color: #1D1E1F;font-weight: bold;margin-top: 12rpx;">{{item.puyu}}</view>
            <view style="font-size: 30rpx;color: #999999;margin-top: 16rpx;">{{item.zhongwen}}</view>
            </view>
            <view wx:else bindtap="switch2" data-id="{{idx}}" style="background-color: #ECF8F8;padding: 70rpx 0;display: flex;align-items: center;justify-content: center;border-bottom: {{data.xiangugan.length-1!=idx?'2':'0'}}rpx #CDE4E3 solid;flex-direction: column;">
            <view style="font-size: 30rpx;color: #62C4C1;font-weight: bold;">点击学习</view>
            <view style="font-size: 52rpx;color: #666666;font-weight: bold;margin-top: 20rpx;">{{item.puyu}}</view>
            <view style="font-size: 30rpx;color: #999999;margin-top: 16rpx;">{{item.zhongwen}}</view>
            </view>

            </view>
            </view>
        </view>
        </swiper-item>
      </view>
</swiper>

<view wx:else>
          <view style="width: 100%;display: flex;align-items: center;justify-content: center;padding-top: 52rpx;box-shadow: 0 -6rpx 11rpx 0 rgba(79,132,108,0.11);border-top-left-radius: 46rpx;border-top-right-radius: 46rpx;">
            <image bindtap="playVoice" data-playing="{{current.map.url}}" src="/image/{{playing_audio_state==current.map.url?'0_playing.gif':'0_play2.png'}}" style="width: 100rpx;height: 100rpx;"/>
          </view>

          <view wx:if="{{current.fy_jiqiao.length>0}}" style="display: flex;align-items: center;margin-top: 20rpx;padding: 0 20rpx;">
          <image src="/image/0_b.png" style="width: 44rpx;height: 44rpx;"/>
          <view style="font-size: 32rpx;color: #1D1E1F;font-weight: bold;margin-left: 14rpx;">发音技巧：</view>
          </view>

          <view wx:if="{{current.fy_jiqiao.length>0}}" style="padding: 20rpx 30rpx;background: rgba(228,238,237,0.42);border-radius: 20rpx;margin-top: 40rpx;word-wrap: break-word;margin-left: 20rpx;margin-right: 20rpx;font-size: 28rpx;color: #7B7B7B;">{{current.fy_jiqiao}}</view>

          <view wx:if="{{data.xiangugan.length>0}}" style="display: flex;align-items: center;margin-top: 50rpx;margin-bottom: 50rpx;padding: 0 20rpx;">
          <image src="/image/0_a.png" style="width: 44rpx;height: 44rpx;"/>
          <view style="font-size: 32rpx;color: #1D1E1F;font-weight: bold;margin-left: 14rpx;">相关发音：</view>
          </view>

          <view>
            <view wx:for="{{data.xiangugan}}" wx:for-index="idx">
            <view wx:if="{{idx==tab2}}" style="background-color: white;padding: 50rpx 0;display: flex;align-items: center;justify-content: center;flex-direction: column;">
            <image wx:if="{{item.img.length>0}}" src="{{item.img}}" mode="aspectFill" style="width: 60vw;height: 30vw;border-radius: 20rpx;border: 2rpx #E7F6F6 solid;"/>
            <image bindtap="playVoice" data-playing="{{item.yinpin}}" mode="aspectFill" src="/image/{{playing_audio_state==item.yinpin?'0_playing.gif':'0_play2.png'}}" style="width: 80rpx;height: 80rpx;margin-top: 30rpx;"/>
            <view style="font-size: 52rpx;color: #1D1E1F;font-weight: bold;margin-top: 12rpx;">{{item.puyu}}</view>
            <view style="font-size: 30rpx;color: #999999;margin-top: 16rpx;">{{item.zhongwen}}</view>
            </view>
            <view wx:else bindtap="switch2" data-id="{{idx}}" style="background-color: #ECF8F8;padding: 70rpx 0;display: flex;align-items: center;justify-content: center;border-bottom: {{data.xiangugan.length-1!=idx?'2':'0'}}rpx #CDE4E3 solid;flex-direction: column;">
            <view style="font-size: 30rpx;color: #62C4C1;font-weight: bold;">点击学习</view>
            <view style="font-size: 52rpx;color: #666666;font-weight: bold;margin-top: 20rpx;">{{item.puyu}}</view>
            <view style="font-size: 30rpx;color: #999999;margin-top: 16rpx;">{{item.zhongwen}}</view>
            </view>

            </view>
            </view>

        </view>

