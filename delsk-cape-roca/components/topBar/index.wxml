<!--components/navigationBar/navigationBar.wxml-->
<view class='nav-bar' style='display:{{ishiddenBar?"none":"block"}};'>
  <view style='width:100%;height:{{statusBarHeight}}rpx;background:{{background}};'></view>
  <view class='cont' style='background:{{background}};height:88rpx;color:{{titleColor}};display:flex;'>
    <!-- {{title}} -->
    <view class='icon-cont' style='height:88rpx;width:190rpx;'>
      <view bindtap='goRealIndex' style='width:50rpx;height:50rpx;' wx:if='{{goIndexReal}}'>      
          <van-icon name="wap-home-o" style="font-size:45rpx;" color="{{titleColor}}"></van-icon>
      </view>
      <view bindtap='goBack' style='width:50rpx;height:50rpx;' wx:if='{{goBack}}'>      
          <van-icon name="arrow-left" style="font-size:45rpx;" color="{{titleColor}}"></van-icon>
      </view>
     
    </view>
    <view style='flex:1;height:88rpx;line-height:88rpx;text-align:center'>{{title}}</view>
    <view style='width:190rpx;height:88rpx'></view>
  </view>
  <!-- <view wx:if='{{haveShadow}}' style='width:100%;height:26rpx'>
    <cover-image src='../../images/shadow_bg.png' style='height:100%;width:100%'></cover-image>
  </view> -->
</view>